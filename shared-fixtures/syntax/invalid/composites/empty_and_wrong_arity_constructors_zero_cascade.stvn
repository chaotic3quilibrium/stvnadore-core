// @spec: SPEC-07-FAULT-ISOLATION
// @case: Negative - Empty and wrong-arity parameterized schema constructors never swallow subsequent :defs declarations
// @error: MALFORMED_SCHEMA
{
  :meta {
    #name "empty_and_wrong_arity_constructors_zero_cascade"
    #kind #BODY
  }
  :defs {
    :EmptyEnum :Enum[]
    :PaddedEmptyEnum :Enum [   ]
    :EmptyTuple :Tuple()
    :PaddedEmptyTuple :Tuple (   )
    :EmptyUnion :Union()
    :PaddedEmptyUnion :Union (   )
    :EmptyOption :Option()
    :OverOption :Option(:Int :String)
    :EmptySeq :Seq()
    :OverSeq :Seq(:Int :String)
    :EmptySet :Set()
    :OverSet :Set(:Int :String)
    :EmptyEither :Either()
    :UnderEither :Either(:Int)
    :OverEither :Either(:Int :String :Boolean)
    :EmptyMap :Map()
    :UnderMap :Map(:String)
    :OverMap :Map(:String :Int :Boolean)

    :ValidPort { #unsigned #size 16 #minIncl 1 } :Int
    #HEALTHY_PORT :ValidPort 443
  }
  :type :Tuple(:EmptyTuple :EmptySeq :UnderMap :ValidPort :ValidPort)
  :body ( "suspended-0" "suspended-1" "suspended-2" #HEALTHY_PORT 0 )
}
