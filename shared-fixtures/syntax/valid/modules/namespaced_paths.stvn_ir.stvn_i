{
  :meta {
    #name "namespaced_paths"
    #domain "stvn_ir"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "stvn_ir_substrate.stvn_ir.stvn_d" ]
    :use [ :org/stvnadore/ir { #strip } ]
  }
  :type :IrSnapshotDocument
  :body (
    {
      [ ":net/http/Status" ( ":Enum[#net/http/OK #net/http/NotFound #net/http/Error]" ":net/http/Status" ( #TRUE #TRUE ) ) ]
      [ ":net/http/Header" ( ":Tuple(:String :String)" ":net/http/Header" ( #TRUE #TRUE ) ) ]
      [ ":app/v1/Response" ( ":Tuple(:net/http/Status :net/http/Header)" ":app/v1/Response" ( #TRUE #TRUE ) ) ]
      [ "<:type>" ( ":Tuple(:net/http/Status :net/http/Header)" ":app/v1/Response" ( #TRUE #TRUE ) ) ]
    }
    #14 [
      #8 ( "#net/http/OK" 0 )
      #14 [
        #5 "Content-Type"
        #5 "application/stvn"
      ]
    ]
  )
}
