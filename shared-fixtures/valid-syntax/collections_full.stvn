{
  // collections_full.stvn
  :defs {
    :IntSequence       :Seq( :Int )
    :NonEmptySequence  { #minSize 1 } :Seq( :String )

    :IntSet            :Set( :Int )
    :NonEmptySet       { #minSize 1 } :Set( :String )

    :LookupMap         :Map( :String :Int )
    :NonEmptyMap       { #minSize 1 } :Map( :String :Int )

    :BiDirectionalMap  { #invertible } :Map( :String :Int )
    :NonEmptyBiMap     { #invertible #minSize 1 } :Map( :String :Int )
  }

  :type :Tuple(
    :IntSequence
    :NonEmptySequence
    :IntSet
    :NonEmptySet
    :LookupMap
    :NonEmptyMap
    :BiDirectionalMap
    :NonEmptyBiMap
  )

  :body (
    [ 10 20 30 40 50 ]
    [ "Alpha" "Beta" "Gamma" ]

    [ 1 2 3 4 5 ]
    [ "UniqueTagA" "UniqueTagB" ]

    {
      [ "port"     8080 ]
      [ "timeout"  30 ]
      [ "retries"  3 ]
    }
    {
      [ "primaryKey" 1 ]
    }

    {
      [ "admin" 0 ]
      [ "user"  1000 ]
      [ "guest" 2000 ]
    }
    {
      [ "root" 0 ]
    }
  )
}
