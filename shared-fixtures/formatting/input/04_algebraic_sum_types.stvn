{
  :defs {
    :AmbiguousEnum :Enum [ #None #Left #OK ]
    :ResultCode :Either ( :Int :String )
    :BoundedUnion :Union (
      { #unsigned #size 8 } :Int
      { #minSize 1 #maxSize 32 } :String
    )
    :OverlappingUnion :Union ( :Int { #minIncl 0 #maxExcl 1000 } :Int )
