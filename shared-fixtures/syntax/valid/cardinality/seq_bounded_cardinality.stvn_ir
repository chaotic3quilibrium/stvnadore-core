TypeRegistry:
  - :BoundedSequence
      schema:
        node: {#minSize1#maxSize8}:Seq(:Int)
        aliasName: :BoundedSequence
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#minSize1#maxSize8}:Seq(:Int)
  - <:type>
      schema:
        node: {#minSize1#maxSize8}:Seq(:Int)
        aliasName: :BoundedSequence
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#minSize1#maxSize8}:Seq(:Int)
ValuePayload:
  StvnSeq
    isNonEmpty: true
    elements:
      - StvnInteger(:Int): 10
      - StvnInteger(:Int): 20
      - StvnInteger(:Int): 30
      - StvnInteger(:Int): 40
      - StvnInteger(:Int): 50