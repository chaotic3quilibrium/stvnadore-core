// @spec: SPEC-09-MODULES-INCLUDES
// @case: Negative - Reject include unresolved collision
// @error: NAMESPACE_COLLISION
{
  :meta {
    #name "include_unresolved_collision"
    #kind #BODY_INCLUDE
  }

  :defs {
    :include [
      "../../valid/modules/module_a.stvn_di"
      "../../valid/modules/module_b.stvn_di"
    ]
  }
  :type :Boolean
  :body #TRUE
}
