TypeRegistry:
  - :BoundedSet
      schema:
        node: {#minSize2#maxSize5}:Set(:String)
        aliasName: :BoundedSet
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: {#minSize2#maxSize5}:Set(:String)
  - <:type>
      schema:
        node: {#minSize2#maxSize5}:Set(:String)
        aliasName: :BoundedSet
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: {#minSize2#maxSize5}:Set(:String)
ValuePayload:
  StvnSet
    isNonEmpty: true
    elements:
      - StvnString(:String): "Alpha"
      - StvnString(:String): "Beta"
      - StvnString(:String): "Gamma"