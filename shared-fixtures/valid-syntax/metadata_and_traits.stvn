{
  // metadata_and_traits.stvn
  :defs {
    :RestrictedPort   { #unsigned #size 16 #minIncl 1024 #maxExcl 65536 } :Int
    :ScoreRange       { #size 64 #minExcl 0.0 #maxIncl 10.0 } :Float
    :NegativeOffset   { #size 32 #minIncl -100 #maxExcl 0 } :Int

    :RegexIdentifier  { #minSize 1 #maxSize 32 #regex "^[a-z][a-z0-9_-]{2,31}$" } :String

    :RawScriptBlock   { #preserveIndent #TRUE } :String

    :BitwiseFloat     { #equatable #TRUE #size 64 } :Float
    :NonEquatableInt  { #equatable #FALSE #size 32 } :Int
  }

  :type :Tuple(
    :RestrictedPort
    :ScoreRange
    :NegativeOffset
    :RegexIdentifier
    :RawScriptBlock
    :BitwiseFloat
    :NonEquatableInt
  )

  :body (
    8080
    9.5
    -50
    "server_node_01"
    """
      Line 1 indented
        Line 2 further indented
    """
    3.141592653589793
    42
  )
}
