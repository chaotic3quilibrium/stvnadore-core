{
  :meta {
    #name "empty_meta_block_with_body_error"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E039 #ERR_EMPTY_META_BLOCK #ERROR 2 9 10 12 "Metadata block ':meta {}' must not be empty" )
    ( #E012 #ERR_CONSTRAINT_VIOLATION #ERROR 7 9 129 133 "Constraint violation (:BoundedPort): Value 5000 is outside allowable range (must be < 4096)" )
  ]
}
