TypeRegistry:
  - :org/example/network/Port
      schema:
        node: :Int
        aliasName: :org/example/network/Port
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Int
  - :org/example/network/HostName
      schema:
        node: :String
        aliasName: :org/example/network/HostName
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :String
  - :org/example/service/ServiceConfig
      schema:
        node: :Tuple(:HostName:Port)
        aliasName: :org/example/service/ServiceConfig
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Tuple(:HostName:Port)
  - <:type>
      schema:
        node: :Tuple(:HostName:Port)
        aliasName: :org/example/service/ServiceConfig
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Tuple(:HostName:Port)
ValuePayload:
  StvnTuple
    elements:
      - StvnString(:org/example/network/HostName): "api.internal"
      - StvnInteger(:org/example/network/Port): 8080
