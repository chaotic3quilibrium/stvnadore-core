// @spec: SPEC-07-NOMINAL-BIJECT
// @case: Positive - Namespaced path navigation and scoping
{
  :meta {
    #name "namespaced_paths"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "network_service.stvn_di" { :net/http/Status :HttpStatus :net/http/Header :HttpHeader } ]

    :app/v1/Response :Tuple( :HttpStatus :HttpHeader )
  }

  :type :app/v1/Response

  :body (
    #net/http/OK
    ( "Content-Type" "application/stvn" )
  )
}
