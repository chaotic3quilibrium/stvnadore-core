// @spec: SPEC-04-DISCRETE-INTERVALS
// @case: Negative - Discrete type prohibits #maxIncl and violates inverted range
// @error: ERR_DISCRETE_BOUND_KIND_PROHIBITED
{
  :meta {
    #name "discrete_max_incl_and_inverted_range"
    #kind #DEFS
  }
  :defs {
    :LatencyWindow { #minIncl 500 #maxIncl 50 } :Int
  }
}
