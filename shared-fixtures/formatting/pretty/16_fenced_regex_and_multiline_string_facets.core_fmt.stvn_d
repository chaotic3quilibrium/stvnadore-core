{
  :meta {
    #name "16_fenced_regex_and_multiline_string_facets"
    #domain "core_fmt"
    #kind #DEFS
  }
  :defs {
    #SLUG_REGEX :String "^[a-z0-9]+(?:\\.[a-z0-9]+)*$"
    :SlugId { #minSize 3 #maxSize 64 #regex "^[a-z0-9]+(?:\\.[a-z0-9]+)*$" } :String
    :TabRowSpec { #minSize 3 #maxSize 48 #preserveIndent #TRUE #regex "^\t[a-z]+\t[0-9]+$" } :String
    :TripleVer { #minSize 5 #maxSize 32 #regex "^[0-9]+\\.[0-9]+\\.[0-9]+$" } :String
  }
}
