{
  // string_facet_size_prohibited.contract.stvn
  :defs {
    :include [ "error_contract.stvn_inclf" ]
  }

  :type :ErrorContract

  :body (
    #ERR_STRING_CARDINALITY_PROHIBITED
    "Facet '#size' is prohibited on :String; use '#minSize' and '#maxSize' (e.g. { #minSize N #maxSize N } :String)"
    "org.stvnadore.core.validation.MalformedSchemaException"
  )
}
