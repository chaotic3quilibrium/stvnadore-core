{
  :meta {
    #name "fenced_string_mismatched_close_body_recovery"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E025 #FENCE_DELIMITER_MISMATCH #ERROR 27 5 481 485 "STVN Syntax Error: Rule STR-04 violation: Unfenced block strings are prohibited; multi-line strings must use fenced syntax \"\"\"[TAG]" )
    ( #E025 #FENCE_DELIMITER_MISMATCH #ERROR 30 5 530 539 "STVN Syntax Error: Rule STR-04 violation: Unclosed fenced string: expected closing delimiter '[SQL]\"\"\"', found mismatched closing tag '[JSON]'" )
    ( #E013 #INVALID_REGEX_PATTERN #ERROR 8 20 185 203 "Constraint violation (:BrokenRegex): Invalid regex pattern: [unclosed" )
    ( #E012 #ERR_CONSTRAINT_VIOLATION #ERROR 25 5 461 465 "Constraint violation (:ShortCode): String length 2 violates #minSize constraint (3)" )
    ( #E013 #REGEX_MISMATCH #ERROR 26 5 470 476 "Constraint violation (:ShortCode): String does not match required pattern: ^[A-Z]+$" )
  ]
}
