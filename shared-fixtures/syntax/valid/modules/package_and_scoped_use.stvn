// @spec: SPEC-09-MODULES-INCLUDES
// @case: Positive - Package declaration and scoped use imports
{
  // package_and_scoped_use.stvn
  // Specification: STVN v1.2.0 (ECD-2026-04)
  :defs {
    :package :org/example/network {
      :Port { #unsigned #size 16 } :Int
      :HostName { #minSize 1 } :String
      #DEFAULT_PORT { #unsigned #size 16 } :Int 8080
    }

    :package :org/example/service {
      :use [ :org/example/network { #strip } ]

      :ServiceConfig :Tuple( :HostName :Port )
    }
  }

  :type :org/example/service/ServiceConfig

  :body (
    "api.internal"
    8080
  )
}
