TypeRegistry:
  - :RestrictedPort
      schema:
        node: {#unsigned#size16#minIncl1024#maxExcl65536}:Int
        aliasName: :RestrictedPort
        constraints:
          equatable: true (default)
          comparable: true (default)
          minIncl: 1024 (explicit override)
          maxExcl: 65536 (explicit override)
        underlyingSchema:
          node: {#unsigned#size16#minIncl1024#maxExcl65536}:Int
  - :ScoreRange
      schema:
        node: {#size64#minExcl0.0#maxIncl10.0}:Float
        aliasName: :ScoreRange
        constraints:
          equatable: false (default)
          comparable: true (default)
          minExcl: 0.0 (explicit override)
          maxIncl: 10.0 (explicit override)
        underlyingSchema:
          node: {#size64#minExcl0.0#maxIncl10.0}:Float
  - :NegativeOffset
      schema:
        node: {#size32#minIncl-100#maxExcl0}:Int
        aliasName: :NegativeOffset
        constraints:
          equatable: true (default)
          comparable: true (default)
          minIncl: -100 (explicit override)
          maxExcl: 0 (explicit override)
        underlyingSchema:
          node: {#size32#minIncl-100#maxExcl0}:Int
  - :RegexIdentifier
      schema:
        node: {#minSize1#maxSize32#regex"^[a-z][a-z0-9_-]{2,31}$"}:String
        aliasName: :RegexIdentifier
        constraints:
          equatable: true (default)
          comparable: true (default)
          regex: "^[a-z][a-z0-9_-]{2,31}$" (explicit override)
        underlyingSchema:
          node: {#minSize1#maxSize32#regex"^[a-z][a-z0-9_-]{2,31}$"}:String
  - :RawScriptBlock
      schema:
        node: {#preserveIndent#TRUE}:String
        aliasName: :RawScriptBlock
        constraints:
          preserveIndent: true (explicit override)
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#preserveIndent#TRUE}:String
  - :BitwiseFloat
      schema:
        node: {#equatable#TRUE#size64}:Float
        aliasName: :BitwiseFloat
        constraints:
          equatable: true (explicit override)
          comparable: true (default)
        underlyingSchema:
          node: {#equatable#TRUE#size64}:Float
  - :NonEquatableInt
      schema:
        node: {#equatable#FALSE#size32}:Int
        aliasName: :NonEquatableInt
        constraints:
          equatable: false (explicit override)
          comparable: true (default)
        underlyingSchema:
          node: {#equatable#FALSE#size32}:Int
  - <:type>
      schema:
        node: :Tuple(:RestrictedPort:ScoreRange:NegativeOffset:RegexIdentifier:RawScriptBlock:BitwiseFloat:NonEquatableInt)
        constraints:
          equatable: false (derived from :ScoreRange)
          comparable: true (default)
ValuePayload:
  StvnTuple
    elements:
      - StvnInteger(:RestrictedPort): 8080
      - StvnFloat(:ScoreRange): 9.5
      - StvnInteger(:NegativeOffset): -50
      - StvnString(:RegexIdentifier): "server_node_01"
      - StvnString(:RawScriptBlock): "      Line 1 indented\n        Line 2 further indented\n    "
      - StvnFloat(:BitwiseFloat): 3.141592653589793
      - StvnInteger(:NonEquatableInt): 42