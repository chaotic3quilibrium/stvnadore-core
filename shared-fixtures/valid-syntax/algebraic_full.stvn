{
  // algebraic_full.stvn
  :defs {
    :OptText       :Option( :String )
    :EitherResult  :Either( :Int :String )
    :DisjointUnion :Union( :Int :Boolean :Float :String )
    :ProductData   :Tuple( :Int :String :Boolean )
  }

  :type :Tuple(
    :OptText
    :OptText
    :OptText
    :OptText
    :OptText

    :EitherResult
    :EitherResult
    :EitherResult
    :EitherResult
    :EitherResult

    :DisjointUnion
    :DisjointUnion
    :DisjointUnion
    :DisjointUnion

    :ProductData
  )

  :body (
    #Some "Explicit long option"
    #S "Explicit short option"
    #None
    #N
    "Implicitly wrapped option"

    #Left 404
    #L 500
    #Right "Explicit long right"
    #R "Explicit short right"
    "Implicitly wrapped right"

    #1 1024
    #2 #TRUE
    #3 99.95
    #4 "Union payload text"

    ( 200 "OK" #TRUE )
  )
}
