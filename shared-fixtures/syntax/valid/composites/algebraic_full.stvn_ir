TypeRegistry:
  - :OptText
      schema:
        node: :Option(:String)
        aliasName: :OptText
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Option(:String)
  - :EitherResult
      schema:
        node: :Either(:Int:String)
        aliasName: :EitherResult
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Either(:Int:String)
  - :DisjointUnion
      schema:
        node: :Union(:Int:Boolean:Float:String)
        aliasName: :DisjointUnion
        constraints:
          equatable: false (derived from :Float)
          comparable: true (default)
        underlyingSchema:
          node: :Union(:Int:Boolean:Float:String)
  - :ProductData
      schema:
        node: :Tuple(:Int:String:Boolean)
        aliasName: :ProductData
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Tuple(:Int:String:Boolean)
  - <:type>
      schema:
        node: :Tuple(:OptText:OptText:OptText:OptText:OptText:EitherResult:EitherResult:EitherResult:EitherResult:EitherResult:DisjointUnion:DisjointUnion:DisjointUnion:DisjointUnion:ProductData)
        constraints:
          equatable: false (derived from :DisjointUnion)
          comparable: true (default)
ValuePayload:
  StvnTuple
    elements:
      - StvnOption
          value: StvnString(:String): "Explicit long option"
      - StvnOption
          value: StvnString(:String): "Explicit short option"
      - StvnOption
          value: null
      - StvnOption
          value: null
      - StvnOption
          value: StvnString(:String): "Implicitly wrapped option"
      - StvnEither
          isRight: false
          value: StvnInteger(:Int): 404
      - StvnEither
          isRight: false
          value: StvnInteger(:Int): 500
      - StvnEither
          isRight: true
          value: StvnString(:String): "Explicit long right"
      - StvnEither
          isRight: true
          value: StvnString(:String): "Explicit short right"
      - StvnEither
          isRight: true
          value: StvnString(:String): "Implicitly wrapped right"
      - StvnUnion
          tagIndex: 0
          value: StvnInteger(:Int): 1024
      - StvnUnion
          tagIndex: 1
          value: StvnBoolean(:Boolean): true
      - StvnUnion
          tagIndex: 2
          value: StvnFloat(:Float): 99.95
      - StvnUnion
          tagIndex: 3
          value: StvnString(:String): "Union payload text"
      - StvnTuple
          elements:
            - StvnInteger(:Int): 200
            - StvnString(:String): "OK"
            - StvnBoolean(:Boolean): true