{
  :meta {
    #name "20_multiline_pure_include_and_comments"
    #domain "core_fmt"
    #kind #BODY_INCLUDE
  }
  :defs {
    :HostName { #minSize 1 #maxSize 64 #regex "^[a-zA-Z0-9.-]+$" } :String
    :Identifier { #minSize 2 #maxSize 64 #preserveIndent #TRUE #regex "^[a-z][a-z0-9_]+$" } :String
    :Port { #unsigned #size 16 #minIncl 1 } :Int
    :Protocol :Enum[#HTTP #HTTPS #TCP #UDP]
    :TimeoutMs { #ms #minIncl 0 #maxExcl 86400000 } :TimeEpoch
    :com/acme/gateway/GatewayRoute :Tuple(:Identifier :HostName :Port :Protocol :TimeoutMs)
  }
  :type :com/acme/gateway/GatewayRoute
  :body ("edge_node_01" "api.internal" 8443 #HTTPS 5000)
}
