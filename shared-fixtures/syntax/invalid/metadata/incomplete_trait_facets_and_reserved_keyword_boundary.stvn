// @error: ERR_INCOMPLETE_TRAIT_FACET
{
  :defs {
    :HealthyRoute { #minSize 4 #maxSize 8 } :String
    :TrapIncompletePreserve { #preserveIndent #maxSize 64 } :String
    :TrapIncompleteEquatable { #equatable #minIncl 0 } :Int
    :TrapIncompleteComparable { #comparable } :String
