{
  :meta { #name "08_schema_defs_module" #domain "core_fmt" #kind #DEFS }
  :defs {
    #DEFAULT_TIMEOUT_MS { #ms } :TimeEpoch 5000
    :RecordEnvelope :Tuple ( :Identifier :TimeoutMs :AuditInstant )
    :TimeoutMs { #ms #minIncl 0 #maxExcl 86400000 } :TimeEpoch
    :Identifier { #minSize 2 #maxSize 64 #preserveIndent #T #regex "^[a-z][a-z0-9_]+$" } :String
    :AuditInstant { #audited #minIncl "2026-01-01T00:00:00-05:00[America/New_York]" #maxExcl "2027-01-01T00:00:00-05:00[America/New_York]" } :DateTime
  }
}
