{
  :meta {
    #name "typo_after_meta"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E002 #STVN_SYNTAX_ERROR #ERROR 5 3 128 133 "STVN Syntax Error: clause ':meta' requires a metadata block '{ ... }'" )
  ]
}
