TypeRegistry:
  - :RestrictedPort
      schema:
        node: :Int
        aliasName: :RestrictedPort
        constraints:
          equatable: true (default)
          comparable: true (default)
          minIncl: 1024 (explicit)
          maxExcl: 65536 (explicit)
        underlyingSchema:
          node: :Int
  - :ScoreRange
      schema:
        node: :Float
        aliasName: :ScoreRange
        constraints:
          equatable: false (default)
          comparable: true (default)
          minExcl: 0.0 (explicit)
          maxIncl: 10.0 (explicit)
        underlyingSchema:
          node: :Float
  - :NegativeOffset
      schema:
        node: :Int
        aliasName: :NegativeOffset
        constraints:
          equatable: true (default)
          comparable: true (default)
          minIncl: -100 (explicit)
          maxExcl: 0 (explicit)
        underlyingSchema:
          node: :Int
  - :RegexIdentifier
      schema:
        node: :String
        aliasName: :RegexIdentifier
        constraints:
          equatable: true (default)
          comparable: true (default)
          regex: "^[a-z][a-z0-9_-]{2,31}$" (explicit)
        underlyingSchema:
          node: :String
  - :RawScriptBlock
      schema:
        node: :String
        aliasName: :RawScriptBlock
        constraints:
          preserveIndent: true (explicit)
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :String
  - :BitwiseFloat
      schema:
        node: :Float
        aliasName: :BitwiseFloat
        constraints:
          equatable: true (explicit override)
          comparable: true (default)
        underlyingSchema:
          node: :Float
  - :NonEquatableInt
      schema:
        node: :Int
        aliasName: :NonEquatableInt
        constraints:
          equatable: false (explicit override)
          comparable: true (default)
        underlyingSchema:
          node: :Int
  - <:type>
      schema:
        node: :Tuple(:RestrictedPort:ScoreRange:NegativeOffset:RegexIdentifier:RawScriptBlock:BitwiseFloat:NonEquatableInt)
        constraints:
          equatable: false (derived from :ScoreRange)
          comparable: true (default)
ValuePayload:
  StvnTuple
    elements:
      - StvnInteger(:RestrictedPort): 8080
      - StvnFloat(:ScoreRange): 9.5
      - StvnInteger(:NegativeOffset): -50
      - StvnString(:RegexIdentifier): "server_node_01"
      - StvnString(:RawScriptBlock): "      Line 1 indented\n        Line 2 further indented\n    "
      - StvnFloat(:BitwiseFloat): 3.141592653589793
      - StvnInteger(:NonEquatableInt): 42