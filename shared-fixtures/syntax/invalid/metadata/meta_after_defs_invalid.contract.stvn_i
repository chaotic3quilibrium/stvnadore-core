{
  :meta {
    #name "meta_after_defs_invalid"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E033 #ERR_META_POSITION_INVALID #ERROR 5 3 39 44 "Misplaced ':meta' section prohibited: ':meta' must appear before ':defs', ':type', and ':body' (canonical order: :meta -> :defs -> :type -> :body)" )
  ]
}
