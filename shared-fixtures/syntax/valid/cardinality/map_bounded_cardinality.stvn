// @spec: SPEC-08-COLLECTIONS
// @case: Positive - Bounded map cardinality between 1 and 10 entries
{
  :meta {
    #name "map_bounded_cardinality"
    #kind #BODY
  }
  :defs {
    :BoundedMap { #minSize 1 #maxSize 10 } :Map( :String :Int )
  }

  :type :BoundedMap
  :body {
    [ "host" 8080 ]
    [ "port" 9090 ]
  }
}
