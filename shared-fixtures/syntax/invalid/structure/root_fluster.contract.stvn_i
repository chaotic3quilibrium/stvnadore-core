{
  :meta {
    #name "root_fluster"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E039 #ERR_EMPTY_META_BLOCK #ERROR 2 9 10 12 "Empty ':meta {}' section is prohibited; declare document identity facets (#name, #domain, #kind)" )
    ( #E003 #ERR_EMPTY_METADATA_BLOCK #ERROR 4 9 32 34 "Empty metadata block is invalid; remove '{}' or specify valid facets" )
    ( #E002 #ERR_MALFORMED_SECTION_STRUCTURE #ERROR 4 3 26 31 "Incomplete ':type' section: declare a target schema type after ':type' (for example, ':type :Int')" )
    ( #E033 #ERR_META_POSITION_INVALID #ERROR 6 3 48 53 "Duplicate ':meta' section prohibited: document may declare at most one ':meta' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 7 3 59 64 "Duplicate ':defs' section prohibited: document may declare at most one ':defs' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 8 3 70 75 "Duplicate ':type' section prohibited: document may declare at most one ':type' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 9 3 81 86 "Duplicate ':body' section prohibited: document may declare at most one ':body' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E033 #ERR_META_POSITION_INVALID #ERROR 10 3 92 97 "Duplicate ':meta' section prohibited: document may declare at most one ':meta' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 11 3 103 108 "Duplicate ':defs' section prohibited: document may declare at most one ':defs' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 12 3 114 119 "Duplicate ':type' section prohibited: document may declare at most one ':type' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 13 3 125 130 "Duplicate ':body' section prohibited: document may declare at most one ':body' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E033 #ERR_META_POSITION_INVALID #ERROR 15 3 137 142 "Duplicate ':meta' section prohibited: document may declare at most one ':meta' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 20 3 213 218 "Duplicate ':defs' section prohibited: document may declare at most one ':defs' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 23 3 245 250 "Duplicate ':type' section prohibited: document may declare at most one ':type' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_DUPLICATE_ROOT_SECTION #ERROR 24 3 259 264 "Duplicate ':body' section prohibited: document may declare at most one ':body' section (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_EMPTY_DEFS_BLOCK #ERROR 3 9 21 23 "Empty ':defs {}' section is prohibited; omit ':defs' or declare at least one type or constant definition" )
  ]
}
