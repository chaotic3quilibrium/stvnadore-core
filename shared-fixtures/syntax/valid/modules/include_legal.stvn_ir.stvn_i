{
  :meta {
    #name "include_legal"
    #domain "stvn_ir"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "stvn_ir_substrate.stvn_ir.stvn_d" { #strip } ]
  }
  :type :IrSnapshotDocument
  :body (
    {
      [ ":TypeA" ( ":Int" ":TypeA" ( #TRUE #TRUE ) ) ]
      [ ":TypeB" ( ":String" ":TypeB" ( #TRUE #TRUE ) ) ]
      [ ":ConflictType" ( ":Int" ":ConflictType" ( #TRUE #TRUE ) ) ]
      [ ":ConflictTypeB" ( ":String" ":ConflictTypeB" ( #TRUE #TRUE ) ) ]
      [ "<:type>" ( ":Tuple(:TypeA :TypeB :ConflictType :ConflictTypeB)" "" ( #TRUE #TRUE ) ) ]
    }
    #14 [
      #2 ( 42 32 #FALSE )
      #5 "hello"
      #2 ( 100 32 #FALSE )
      #5 "world"
    ]
  )
}
