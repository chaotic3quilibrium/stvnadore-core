    ( #E008 #ERR_STRING_CARDINALITY_PROHIBITED #ERROR 6 18 161 169 "Facet '#size' is prohibited on :String; use '#minSize' and '#maxSize' (e.g. { #minSize N #maxSize N } :String)" )
  ]
}
