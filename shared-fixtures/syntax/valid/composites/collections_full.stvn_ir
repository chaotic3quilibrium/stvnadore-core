TypeRegistry:
  - :IntSequence
      schema:
        node: :Seq(:Int)
        aliasName: :IntSequence
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Seq(:Int)
  - :NonEmptySequence
      schema:
        node: :Seq(:String)
        aliasName: :NonEmptySequence
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Seq(:String)
  - :IntSet
      schema:
        node: :Set(:Int)
        aliasName: :IntSet
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: :Set(:Int)
  - :NonEmptySet
      schema:
        node: :Set(:String)
        aliasName: :NonEmptySet
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: :Set(:String)
  - :LookupMap
      schema:
        node: :Map(:String:Int)
        aliasName: :LookupMap
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: :Map(:String:Int)
  - :NonEmptyMap
      schema:
        node: :Map(:String:Int)
        aliasName: :NonEmptyMap
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: :Map(:String:Int)
  - :BiDirectionalMap
      schema:
        node: :Map(:String:Int)
        aliasName: :BiDirectionalMap
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: :Map(:String:Int)
  - :NonEmptyBiMap
      schema:
        node: :Map(:String:Int)
        aliasName: :NonEmptyBiMap
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: :Map(:String:Int)
  - <:type>
      schema:
        node: :Tuple(:IntSequence:NonEmptySequence:IntSet:NonEmptySet:LookupMap:NonEmptyMap:BiDirectionalMap:NonEmptyBiMap)
        constraints:
          equatable: true (default)
          comparable: false (derived from :IntSet)
ValuePayload:
  StvnTuple
    elements:
      - StvnSeq
          elements:
            - StvnInteger(:Int): 10
            - StvnInteger(:Int): 20
            - StvnInteger(:Int): 30
            - StvnInteger(:Int): 40
            - StvnInteger(:Int): 50
      - StvnSeq
          isNonEmpty: true
          elements:
            - StvnString(:String): "Alpha"
            - StvnString(:String): "Beta"
            - StvnString(:String): "Gamma"
      - StvnSet
          elements:
            - StvnInteger(:Int): 1
            - StvnInteger(:Int): 2
            - StvnInteger(:Int): 3
            - StvnInteger(:Int): 4
            - StvnInteger(:Int): 5
      - StvnSet
          isNonEmpty: true
          elements:
            - StvnString(:String): "UniqueTagA"
            - StvnString(:String): "UniqueTagB"
      - StvnMap
          entries:
            - pair:
                key: StvnString(:String): "port"
                value: StvnInteger(:Int): 8080
            - pair:
                key: StvnString(:String): "timeout"
                value: StvnInteger(:Int): 30
            - pair:
                key: StvnString(:String): "retries"
                value: StvnInteger(:Int): 3
      - StvnMap
          isNonEmpty: true
          entries:
            - pair:
                key: StvnString(:String): "primaryKey"
                value: StvnInteger(:Int): 1
      - StvnMap
          isInvertible: true
          entries:
            - pair:
                key: StvnString(:String): "admin"
                value: StvnInteger(:Int): 0
            - pair:
                key: StvnString(:String): "user"
                value: StvnInteger(:Int): 1000
            - pair:
                key: StvnString(:String): "guest"
                value: StvnInteger(:Int): 2000
      - StvnMap
          isNonEmpty: true
          isInvertible: true
          entries:
            - pair:
                key: StvnString(:String): "root"
                value: StvnInteger(:Int): 0
