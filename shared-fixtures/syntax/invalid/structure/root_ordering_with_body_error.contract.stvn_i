{
  :meta {
    #name "root_ordering_with_body_error"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E002 #ERR_SECTION_ORDER_VIOLATION #ERROR 3 3 17 22 "Misplaced ':type' section prohibited: ':type' must appear before ':body' (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E002 #ERR_SECTION_ORDER_VIOLATION #ERROR 4 3 31 36 "Misplaced ':defs' section prohibited: ':defs' must appear before ':type' and ':body' (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E033 #ERR_META_POSITION_INVALID #ERROR 7 3 78 83 "Misplaced ':meta' section prohibited: ':meta' must appear before ':defs', ':type', and ':body' (canonical order: :meta -> :defs -> :type -> :body)" )
    ( #E012 #ERR_CONSTRAINT_VIOLATION #ERROR 2 9 10 14 "Constraint violation (:Port): Value 5000 is outside allowable range (must be < 4096)" )
  ]
}
