TypeRegistry:
  - :IndentedBlock
      schema:
        node: {#preserveIndent}:String
        aliasName: :IndentedBlock
        constraints:
          preserveIndent: true (explicit override)
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#preserveIndent}:String
  - :UnsignedPort
      schema:
        node: {#unsigned#size16}:Int
        aliasName: :UnsignedPort
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#unsigned#size16}:Int
  - :ExactCurrency
      schema:
        node: {#exact}:Float
        aliasName: :ExactCurrency
        constraints:
          equatable: false (default)
          comparable: true (default)
        underlyingSchema:
          node: {#exact}:Float
  - :BijectiveRegistry
      schema:
        node: {#invertible}:Map(:String:Int)
        aliasName: :BijectiveRegistry
        constraints:
          equatable: true (default)
          comparable: false (default)
        underlyingSchema:
          node: {#invertible}:Map(:String:Int)
  - :UtcTimestamp
      schema:
        node: {#offset}:DateTime
        aliasName: :UtcTimestamp
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#offset}:DateTime
  - :JurisdictionTime
      schema:
        node: {#zoned}:DateTime
        aliasName: :JurisdictionTime
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#zoned}:DateTime
  - :AuditedEventTime
      schema:
        node: {#audited}:DateTime
        aliasName: :AuditedEventTime
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: {#audited}:DateTime
  - <:type>
      schema:
        node: :Tuple(:IndentedBlock:UnsignedPort:ExactCurrency:BijectiveRegistry:UtcTimestamp:JurisdictionTime:AuditedEventTime)
        constraints:
          equatable: false (derived from :ExactCurrency)
          comparable: false (derived from :BijectiveRegistry)
ValuePayload:
  StvnTuple
    elements:
      - StvnString(:IndentedBlock): "      Indented block line 1\n        Indented block line 2\n    "
      - StvnInteger(:UnsignedPort): 8080
      - StvnFloat(:ExactCurrency): 199.99
      - StvnMap
          isInvertible: true
          entries:
            - pair:
                key: StvnString(:String): "alpha"
                value: StvnInteger(:Int): 1
            - pair:
                key: StvnString(:String): "beta"
                value: StvnInteger(:Int): 2
      - StvnDateTimeOffset(:UtcTimestamp): 2026-09-21T17:30Z
      - StvnDateTimeZoned(:JurisdictionTime): 2026-09-21T17:30[America/Chicago]
      - StvnDateTimeAudited(:AuditedEventTime): 2026-09-21T17:30-05:00[America/Chicago]