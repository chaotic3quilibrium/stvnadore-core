// @spec: SPEC-09-MODULES-INCLUDES
// @case: Positive - Asymmetric include eviction precedence
{
  :meta {
    #name "include_asymmetric_eviction"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [
      "./module_asym_a.stvn_di"
      "./module_asym_b.stvn_di"
    ]
    :use [ :org/example/asym_a { :ConflictType :AliasedType } ]
  }
  :type :Tuple( :AliasedType :ConflictType )
  :body ( 42 "hello" )
}
