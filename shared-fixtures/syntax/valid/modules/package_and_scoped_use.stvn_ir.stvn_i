{
  :meta {
    #name "package_and_scoped_use"
    #domain "stvn_ir"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "stvn_ir_substrate.stvn_ir.stvn_d" { #strip } ]
  }
  :type :IrSnapshotDocument
  :body (
    {
      [ ":org/example/network/HostName" ( "{#minSize 1}:String" ":org/example/network/HostName" ( #TRUE #TRUE ) ) ]
      [ ":org/example/network/Port" ( "{#unsigned #size 16}:Int" ":org/example/network/Port" ( #TRUE #TRUE ) ) ]
      [ ":org/example/service/ServiceConfig" ( ":Tuple(:org/example/network/HostName :org/example/network/Port)" ":org/example/service/ServiceConfig" ( #TRUE #TRUE ) ) ]
      [ "<:type>" ( ":Tuple(:org/example/network/HostName :org/example/network/Port)" ":org/example/service/ServiceConfig" ( #TRUE #TRUE ) ) ]
    }
    #14 [
      #5 "api.internal"
      #2 ( 8080 16 #TRUE )
    ]
  )
}
