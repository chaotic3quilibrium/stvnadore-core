{
  :meta {
    #name "algebraic_full"
    #domain "ir"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../modules/stvn_ir_substrate.stvn_d" { #strip } ]
  }
  :type :IrSnapshotDocument
  :body (
    {
      [ ":OptText" ( ":Option(:String)" ":OptText" ( #TRUE #TRUE ) ) ]
      [ ":EitherResult" ( ":Either(:Int:String)" ":EitherResult" ( #TRUE #TRUE ) ) ]
      [ ":DisjointUnion" ( ":Union(:Int:Boolean:Float:String)" ":DisjointUnion" ( #FALSE #TRUE ) ) ]
      [ ":ProductData" ( ":Tuple(:Int:String:Boolean)" ":ProductData" ( #TRUE #TRUE ) ) ]
      [ "<:type>" ( ":Tuple(:OptText:OptText:OptText:OptText:OptText:EitherResult:EitherResult:EitherResult:EitherResult:EitherResult:DisjointUnion:DisjointUnion:DisjointUnion:DisjointUnion:ProductData)" "" ( #FALSE #TRUE ) ) ]
    }
    #11 [
      #6 ( #SOME
        #4 "Explicit long option"
      )
      #6 ( #SOME
        #4 "Explicit short option"
      )
      #7 #NONE
      #7 #NONE
      #6 ( #SOME
        #4 "Implicitly wrapped option"
      )
      #8 ( #LEFT
        #2 ( 404 32 #FALSE )
      )
      #8 ( #LEFT
        #2 ( 500 32 #FALSE )
      )
      #9 ( #RIGHT
        #4 "Explicit long right"
      )
      #9 ( #RIGHT
        #4 "Explicit short right"
      )
      #9 ( #RIGHT
        #4 "Implicitly wrapped right"
      )
      #10 ( 1
        #2 ( 1024 32 #FALSE )
      )
      #10 ( 2
        #1 #TRUE
      )
      #10 ( 3
        #3 99.95
      )
      #10 ( 4
        #4 "Union payload text"
      )
      #11 [
        #2 ( 200 32 #FALSE )
        #4 "OK"
        #1 #TRUE
      ]
    ]
  )
}