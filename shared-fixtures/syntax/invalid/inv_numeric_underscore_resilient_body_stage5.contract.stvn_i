  :type :ErrorContract
  :body [
    ( #E002 #ERR_INVALID_NUMERIC_LITERAL #ERROR 21 5 476 502 "STVN Syntax Error: Underscore separators are prohibited in numeric literals: '0x1000_0000_0000_0000_0001'" )
