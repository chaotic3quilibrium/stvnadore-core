      [ ":GeoLat" ( "{#minIncl -90.0 #maxIncl 90.0}:Float" ":GeoLat" ( #FALSE #TRUE ) ) ]
      [ ":GeoLon" ( "{#minIncl -180.0 #maxIncl 180.0}:Float" ":GeoLon" ( #FALSE #TRUE ) ) ]
