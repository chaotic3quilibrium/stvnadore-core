      [ "<:type>" ( ":Tuple(:propulsion/thruster/ThrustMillinewtons :propulsion/attitude/ThrustMillinewtons :propulsion/attitude/BusStatus :propulsion/telemetry/TelemetrySample :org/stvnadore/prelude/Port)" ":DispatchEnvelope" ( #TRUE #TRUE ) ) ]
    }
