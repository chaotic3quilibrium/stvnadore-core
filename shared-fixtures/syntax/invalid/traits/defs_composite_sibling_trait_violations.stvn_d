// @spec: SPEC-06-TRAIT-CAPABILITY
// @case: Negative - Composite nominal definitions with sibling trait violations in defs
// @error: TRAIT_VIOLATION
{
  :meta {
    #name "defs_composite_sibling_trait_violations"
    #kind #DEFS
  }
  :defs {
    :NonEq1 :Tuple( :Float )
    :NonEq2 :Tuple( :Float :Float )
    :BadComposite :Tuple( :Set( :NonEq1 ) :Set( :NonEq2 ) )
  }
}
