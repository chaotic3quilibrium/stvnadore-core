{
  :meta {
    #name "meta_omitted_domain_with_body_error"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #W002 #WARN_DOCUMENT_DOMAIN_OMITTED_IN_META #WARNING 2 3 4 9 "Filename stem slot 1 declares domain 'core_test', but :meta omits #domain \"core_test\"" )
    ( #E012 #ERR_CONSTRAINT_VIOLATION #ERROR 10 9 204 208 "Constraint violation (:BoundedPort): Value 5000 is outside allowable range (must be < 4096)" )
  ]
}
