{
  :meta {
    #name "trap4_unbracketed_include"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E002 #STVN_SYNTAX_ERROR #ERROR 6 14 136 156 "STVN Syntax Error: unexpected token '\"./module_a.stvn_di\"'; expected <schema type>" )
    ( #E031 #ERR_DOCUMENT_KIND_MISMATCH #ERROR 4 1 111 112 "Mandatory :meta block missing; document kind '#BODY_INCLUDE' is required for extension '.stvn_i'" )
  ]
}
