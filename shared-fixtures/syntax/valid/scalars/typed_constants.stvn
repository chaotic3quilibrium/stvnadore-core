// @spec: SPEC-01-SCALAR-KERNEL
// @case: Positive - Typed constant declarations and evaluations
{
  // typed_constants.stvn
  :defs {
    :RetryCount         { #unsigned #size 8 } :Int
    :PortNum            { #unsigned #size 16 } :Int
    :CoordFloat         { #size 32 } :Float

    #MAX_RETRY          :RetryCount 3
    #API_HOST           { #regex "^[a-z.]+$" } :String "api.internal.net"
    #BASE_PORT          :PortNum 8000
    #SERVICE_PORT       :PortNum #BASE_PORT
    #DEFAULT_COORDINATES :Tuple( :CoordFloat :CoordFloat ) ( 12.34 56.78 )
    #ALLOWED_PORTS      :Seq( :PortNum ) [ 80 443 8080 ]
  }

  :type :Tuple(
    :RetryCount
    :String
    :PortNum
    :Tuple( :CoordFloat :CoordFloat )
    :Seq( :PortNum )
  )

  :body (
    #MAX_RETRY
    #API_HOST
    #SERVICE_PORT
    #DEFAULT_COORDINATES
    #ALLOWED_PORTS
  )
}
