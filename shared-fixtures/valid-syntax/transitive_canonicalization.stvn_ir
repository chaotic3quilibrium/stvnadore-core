TypeRegistry:
  - :org/stvnadore/finance/Transaction
      schema:
        node: :Tuple(:Int:Float)
        aliasName: :org/stvnadore/finance/Transaction
        constraints:
          equatable: false (derived from :Float)
          comparable: true (default)
        underlyingSchema:
          node: :Tuple(:Int:Float)
  - :org/stvnadore/finance/CreationTime
      schema:
        node: :Int
        aliasName: :org/stvnadore/finance/CreationTime
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Int
  - :A
      schema:
        node: :String
        aliasName: :A
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :String
  - :T
      schema:
        node: :Tuple(:LocalTx:A)
        aliasName: :T
        constraints:
          equatable: false (derived from :org/stvnadore/finance/Transaction)
          comparable: true (default)
        underlyingSchema:
          node: :Tuple(:LocalTx:A)
  - <:type>
      schema:
        node: :Tuple(:LocalTx:A)
        aliasName: :T
        constraints:
          equatable: false (derived from :org/stvnadore/finance/Transaction)
          comparable: true (default)
        underlyingSchema:
          node: :Tuple(:LocalTx:A)
ValuePayload:
  StvnTuple
    elements:
      - StvnTuple
          elements:
            - StvnInteger(:Int): 1001
            - StvnFloat(:Float): 49.99
      - StvnString(:A): "a"
