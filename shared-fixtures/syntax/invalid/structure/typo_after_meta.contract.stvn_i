{
  :meta {
    #name "typo_after_meta"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E002 #STVN_SYNTAX_ERROR #ERROR 5 3 128 133 "STVN Syntax Error: clause ':meta' requires a metadata block '{ ... }'" )
    ( #E031 #ERR_DOCUMENT_KIND_MISMATCH #ERROR 4 1 124 125 "Mandatory ':type' and ':body' sections missing; hermetic payload document ('typo_after_meta.stvn') requires payload schema and body value" )
  ]
}
