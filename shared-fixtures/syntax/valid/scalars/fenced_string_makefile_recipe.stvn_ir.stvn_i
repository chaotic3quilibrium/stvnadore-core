{
  :meta {
    #name "fenced_string_makefile_recipe"
    #domain "stvn_ir"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../modules/stvn_ir_substrate.stvn_ir.stvn_d" { #strip } ]
  }
  :type :IrSnapshotDocument
  :body (
    {
      [ ":MakefileScript" ( "{#preserveIndent #T}:String" ":MakefileScript" ( #TRUE #TRUE ) ) ]
      [ "<:type>" ( "{#preserveIndent #T}:String" ":MakefileScript" ( #TRUE #TRUE ) ) ]
    }
    #5 "all: build test\n\nbuild:\n\tgcc -O2 main.c -o app\n\ntest:\n\t./app --test\n"
  )
}
