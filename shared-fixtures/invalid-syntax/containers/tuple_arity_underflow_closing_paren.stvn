// @spec: SPEC-07-CARDINALITY-PINNING
// @case: Negative - Tuple arity underflow pinned strictly to closing parenthesis
// @error: TUPLE_ARITY_MISMATCH
{
  :meta {
    #name "tuple_arity_underflow_closing_paren"
  }
  :defs {
    :Symbol :String
    :PriceOffset :Int
    :TradeTimestamp :Int
  }
  :type :Tuple( :Symbol :PriceOffset :TradeTimestamp )
  :body ( "AAPL" 150 )
}
