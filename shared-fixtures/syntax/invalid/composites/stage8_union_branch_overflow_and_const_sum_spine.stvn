  :type :Tuple( :OuterDispatchEnvelope :OuterDispatchEnvelope :OuterDispatchEnvelope :TelemetryBranch )
  :body ( #IRREDUCIBLE_DEF_NONE #REDUCIBLE_DEF_LEAF #PKG_REDUCIBLE_LEAF #3 #TRUE )
