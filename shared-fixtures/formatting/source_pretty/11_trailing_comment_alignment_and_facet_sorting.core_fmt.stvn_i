{
  :meta {
    #name "11_trailing_comment_alignment_and_facet_sorting" // meta name comment
    #domain "core_fmt"           // aligned meta domain comment
    #kind #BODY_INCLUDE          // aligned meta kind comment
  }
  :defs {
    :package :com/acme/align {
      #DEFAULT_PORT :Int 8080 // trailing comment on inline package child
    }

    :use [ :com/acme/align { #strip } ]

    :use [ :org/stvnadore/prelude {                   // <-- Aligned trailing comment
        :Port :Port                                   // <-- Aligned trailing comment
        #SHA256_LOWER_CASE_REGEX #SHA256_LOWER_CASE_REGEX // <-- Aligned trailing comment
      }                                               // <-- Aligned trailing comment
    ]

    :BoundedChannel {
      #unsigned                  // representation facet comment
      #size 16                   // bit-width facet comment
      #minIncl 1                 // lower bound facet comment
      #maxExcl 60000             // upper bound facet comment
    } :Int

    :ScrambledFacetOrderTrap {
      #unsigned
      #size 16
      #comparable #FALSE
      #minIncl 10
      #maxExcl 100
    } :Int

    :ChannelLabel { #minSize 1 #maxSize 128 #regex #SHA256_LOWER_CASE_REGEX } :String
  }
  :type :Tuple(
    :Int
    :Port
    :BoundedChannel // single-space comment
    :ScrambledFacetOrderTrap
    :ChannelLabel
  )
  :body (
    #DEFAULT_PORT
    8080 // zero-space comment
    4096
    42
    "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  )
}
