// @spec: SPEC-04-ENUM-SUBSET
// @case: Negative - Enum subset root order violation
// @error: ENUM_SUBSET_ORDER_VIOLATION
{
  :meta {
    #name "enum_subset_root_order_violation"
    #kind #DEFS
  }
  :defs {
    :Status :Enum [ #Pending #Active #Suspended #Deleted ]
    :IllegalOrder { #filterIncl [ #Active #Pending ] } :Status
  }
}