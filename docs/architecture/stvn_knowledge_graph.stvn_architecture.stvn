{
  // docs/architecture/stvn_knowledge_graph.stvn_architecture.stvn
  // Canonical Single Source of Truth (SSoT) for the STVN 2.0.0 Exploratory Knowledge Graph
  :meta {
    #name "stvn_knowledge_graph"
    #domain "stvn_architecture"
    #kind #BODY
  }
  :defs {
    // 1. Node Archetype & Perspective Lens Taxonomies
    :NodeArchetype :Enum [
      #DISSONANCE
      #SPEC
      #GOAL
      #HAZARD
    ]

    :PerspectiveLens :Enum [
      #LENS_SKEPTIC
      #LENS_DATA_ENGINEER
      #LENS_ZERO_TRUST
      #LENS_VOP_PURIST
      #LENS_PRACTITIONER
    ]

    // 2. Causal Edge Verb Taxonomy
    :CausalVerb :Enum [
      #CLASHES_WITH
      #JUSTIFIED_BY
      #ELIMINATES_HAZARD
      #ENABLES_OPTIMIZATION
      #DERIVES_FROM
      #ENFORCES_BOUNDARY
    ]

    // 3. Constrained Domain Identifiers (Tier 1.5 Cardinality -> Tier 4.4 Regex)
    :NodeId { #minSize 6 #maxSize 96 #regex "^(DISSONANCE|SPEC|GOAL|HAZARD)_[A-Z0-9_]+$" } :String
    :EdgeId { #minSize 6 #maxSize 96 #regex "^EDGE_[A-Z0-9_]+$" } :String
    :DiagnosticCode { #minSize 4 #maxSize 64 #regex "^(E[0-9]{3}|W[0-9]{3}|ERR_[A-Z0-9_]+|WARN_[A-Z0-9_]+|[A-Za-z0-9]+Exception)$" } :String
    :SpecSectionRef { #minSize 1 #maxSize 64 } :String
    :NonEmptyProse { #minSize 1 #maxSize 2048 } :String
    :LensSet { #minSize 1 #maxSize 5 } :Set(:PerspectiveLens)

    // 4. Graph Node & Causal Edge Product Definitions (IDs are Map Keys, 3NF Normalized)
    :KgNode :Tuple(
      :NodeArchetype
      :NonEmptyProse
      :NonEmptyProse
      :Seq(:SpecSectionRef)
      :Seq(:DiagnosticCode)
      :LensSet
    )

    :KgEdge :Tuple(
      :NodeId
      :CausalVerb
      :NodeId
      :NonEmptyProse
      :LensSet
    )

    // 5. Root Knowledge Graph Container
    :NodeRegistry { #minSize 1 } :Map(:NodeId :KgNode)
    :EdgeCatalog { #minSize 1 } :Map(:EdgeId :KgEdge)
    :StvnKnowledgeGraph :Tuple(:NodeRegistry :EdgeCatalog)
  }

  :type :StvnKnowledgeGraph

  :body (
    // ========================================================================
    // PART 1: NODE REGISTRY (102 NODES: CLUSTERS 1-19 + SUBSYSTEMS A-G)
    // ========================================================================
    {
      // --- CLUSTER 1: Infix Colons and Comma Separators ---
      [
        "DISSONANCE_NO_INFIX_COLON_OR_COMMAS"
        (
          #DISSONANCE
          "Why can't I write 'host: localhost' or separate list items with commas like in JSON?"
          "Developers accustomed to JSON, YAML, and TypeScript expect infix colons for key-value pairs and commas between array/tuple elements."
          [ "Lang 3.1" "Lang 3.2" "Lang Appendix C.1 Trap 7" ]
          [ "E030" "ERR_BARE_COLON_PROHIBITED" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER ]
        )
      ]
      [
        "SPEC_DUAL_TRACK_SIGILS_AND_WHITESPACE_DELIMITATION"
        (
          #SPEC
          "Dual-Track Prefix Sigils (':' and '#') and Whitespace-Only Sibling Delimitation"
          "The colon ':' is strictly a bound prefix sigil for the Typic Track and '#' is strictly a bound prefix sigil for the Value Track. Sibling values are delimited exclusively by whitespace, and grouping uses only {}, [], and ()."
          [ "Lang 3.1" "Lang 3.2" "Lang Appendix C.1 Trap 7" ]
          [ "E030" "ERR_BARE_COLON_PROHIBITED" "ERR_BARE_HASH_PROHIBITED" ]
          [ #LENS_PRACTITIONER #LENS_VOP_PURIST ]
        )
      ]
      [
        "GOAL_SINGLE_PASS_LL1_LEXICAL_ISOLATION"
        (
          #GOAL
          "Single-Pass LL(1) Lexical Isolation Between Type and Value Spaces"
          "Guarantee context-free lexical disambiguation between type-space identifiers (':') and value-space tokens ('#') at the first character without lookahead or punctuation noise."
          [ "Lang 3.1" "Lang 3.2" "Lang 3.8.2" ]
          []
          [ #LENS_DATA_ENGINEER #LENS_VOP_PURIST ]
        )
      ]
      [
        "HAZARD_SYNTACTIC_ROLE_AMBIGUITY"
        (
          #HAZARD
          "Trailing-Comma Parse Failures and Key-vs-Type Lookahead Ambiguity"
          "Eliminates trailing-comma syntax bugs, key-vs-type identifier ambiguity during AST construction, and multi-token parser backtracking."
          [ "Lang 3.1" "Lang 3.2" ]
          [ "E030" ]
          [ #LENS_DATA_ENGINEER #LENS_PRACTITIONER ]
        )
      ]

      // --- CLUSTER 2: Hash Comments & Block Comments Prohibition ---
      [
        "DISSONANCE_HASH_AND_BLOCK_COMMENTS_FORBIDDEN"
        (
          #DISSONANCE
          "Why does '# comment' crash the lexer and why are '/* ... */' block comments illegal?"
          "Engineers coming from Python, Bash, YAML, or C/Java expect '#' line comments or '/* ... */' multi-line block comments."
          [ "Lang 3.1" "Lang 3.4" "Lang Appendix C.1 Trap 6" ]
          [ "E001" "E030" "ERR_BARE_HASH_PROHIBITED" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER ]
        )
      ]
      [
        "SPEC_C_STYLE_SINGLE_LINE_COMMENTS_ONLY"
        (
          #SPEC
          "Exclusive C-Style Single-Line ('//') Comment Discipline"
          "Comments are restricted exclusively to contiguous single-line '//' tokens discarded prior to AST construction. Standalone '#' and block '/* ... */' comments are rejected."
          [ "Lang 3.1" "Lang 3.4" "Lang Appendix C.1 Trap 6" ]
          [ "E001" "E030" "ERR_BARE_HASH_PROHIBITED" ]
          [ #LENS_PRACTITIONER ]
        )
      ]
      [
        "GOAL_SIGIL_UNIFORMITY_AND_LINE_LOCAL_LEXING"
        (
          #GOAL
          "Value Sigil Uniformity and Line-Local Comment Lexing"
          "Reserve '#' exclusively for the Value/Variable sigil track (booleans, sum tags, union indices, enum constants, metadata facets) and keep comment lexing strictly line-local."
          [ "Lang 3.1" "Lang 3.4" ]
          []
          [ #LENS_VOP_PURIST #LENS_PRACTITIONER ]
        )
      ]
      [
        "HAZARD_UNCLOSED_BLOCK_COMMENT_CODE_SWALLOWING"
        (
          #HAZARD
          "Accidental Schema/Payload Swallowing via Unclosed Block Comments or Hash Ambiguity"
          "Prevents accidental commenting-out of active schema constraints via unclosed '/*' markers and prevents '#' value tags from being silently ignored as comments."
          [ "Lang 3.1" "Lang 3.4" ]
          [ "ERR_BARE_HASH_PROHIBITED" ]
          [ #LENS_ZERO_TRUST #LENS_PRACTITIONER ]
        )
      ]

      // --- CLUSTER 3: Strict Zero-Tab Invariant ---
      [
        "DISSONANCE_STRICT_ZERO_TAB_INVARIANT"
        (
          #DISSONANCE
          "Why does a single tab character in indentation or a comment halt compilation with E001?"
          "Developers accustomed to Makefiles, Go, or configurable IDE tab indentation find fatal compilation on '\\t' overly strict."
          [ "Lang 1.3" "Lang 3.3" "Lang Appendix C.2" ]
          [ "E001" "ERR_TAB_CHARACTER_FORBIDDEN" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER ]
        )
      ]
      [
        "SPEC_ZERO_TAB_LEXICAL_INVARIANT"
        (
          #SPEC
          "Strict Zero-Tab Invariant Outside Fenced String Verbatim Bodies"
          "Raw horizontal tabs (0x09) are prohibited in structural whitespace, indentation, comments, and single-line strings, and permitted exclusively inside verbatim bodies of Rule STR-04 fenced strings."
          [ "Lang 1.3" "Lang 3.3" "Lang 5.3" ]
          [ "E001" "ERR_TAB_CHARACTER_FORBIDDEN" ]
          [ #LENS_PRACTITIONER #LENS_ZERO_TRUST ]
        )
      ]
      [
        "GOAL_DETERMINISTIC_DIAGNOSTIC_COORDINATE_PINNING"
        (
          #GOAL
          "Deterministic 1:1 Byte-Offset to Visual Column Coordinate Pinning"
          "Guarantee that exact character intervals [startOffset, endOffset) map 1:1 to visual columns across all IDEs, CLI compilers, and forensic quarantine auditors."
          [ "Lang 1.3" "Lang 3.3" "Lang 7.3" ]
          []
          [ #LENS_PRACTITIONER #LENS_ZERO_TRUST ]
        )
      ]
      [
        "HAZARD_EDITOR_COLUMN_DRIFT_AND_WHITESPACE_SPOOFING"
        (
          #HAZARD
          "Tab-Width Visual Column Drift and Quarantine AST Verification Failure"
          "Eliminates tab-width rendering divergence (2 vs 4 vs 8 spaces) that misaligns diagnostic carets and causes INVALID_INNER_AST rejections in CAS repository sweeps."
          [ "Lang 1.3" "Lang 7.3" "Repo 6.2" ]
          [ "E001" "ERR_TAB_CHARACTER_FORBIDDEN" ]
          [ #LENS_PRACTITIONER #LENS_ZERO_TRUST ]
        )
      ]

      // --- CLUSTER 4: Mandatory Discriminator Tags on Multi-Line Strings ---
      [
        "DISSONANCE_MANDATORY_FENCED_STRING_TAGS"
        (
          #DISSONANCE
          "Why are bare triple-quoted strings and '->' arrow fences rejected at compile time?"
          "Developers coming from Python, Kotlin, Scala, or STVN 1.x expect bare triple quotes or arrow-prefixed multi-line string literals."
          [ "Lang 5.3" "Lang Appendix C.2" ]
          [ "E025" "E026" "ERR_PROHIBITED_FENCE_ARROW" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER ]
        )
      ]
      [
        "SPEC_RULE_STR_04_POLYGLOT_FENCED_STRINGS"
        (
          #SPEC
          "Rule STR-04 Polyglot Fenced Strings with Matching [TAG] Discriminators"
          "Multi-line strings must declare matching opening and closing tags (^[a-zA-Z0-9_-]{1,256}$) enforced via lexer mode semantic predicate. Unfenced block strings and '->' arrows are excised."
          [ "Lang 5.3" "Lang Appendix B.7" "Lang Appendix D.2" ]
          [ "E025" "E026" "ERR_PROHIBITED_FENCE_ARROW" ]
          [ #LENS_PRACTITIONER #LENS_ZERO_TRUST ]
        )
      ]
      [
        "GOAL_HERMETIC_POLYGLOT_AND_CAS_ENVELOPE_ENCAPSULATION"
        (
          #GOAL
          "Zero-Escape Polyglot Embedding and Recursive STVN-in-STVN CAS Envelopes"
          "Enable verbatim embedding of foreign code (SQL, Makefiles with tabs) and recursive STVN-inside-STVN CAS envelopes using [SHA256-<hash>] discriminator tags."
          [ "Lang 5.3" "Lang Appendix B.7" "Repo 3.1.2" ]
          []
          [ #LENS_ZERO_TRUST #LENS_DATA_ENGINEER #LENS_PRACTITIONER ]
        )
      ]
      [
        "HAZARD_NESTED_QUOTE_COLLISION_AND_INJECTION"
        (
          #HAZARD
          "Premature Multi-Line String Termination and Nested Payload Injection"
          "Prevents embedded triple-quotes inside inner STVN documents or SQL payloads from prematurely closing the outer literal and injecting rogue AST tokens."
          [ "Lang 5.3" "Lang Appendix D.2" ]
          [ "E025" ]
          [ #LENS_ZERO_TRUST #LENS_PRACTITIONER ]
        )
      ]

      // --- CLUSTER 5: Positional Product Tuples Instead of Named-Field Objects ---
      [
        "DISSONANCE_POSITIONAL_TUPLES_NO_NAMED_RECORDS"
        (
          #DISSONANCE
          "Why do composite records use positional ':Tuple' instead of named JSON object keys?"
          "Developers accustomed to JSON objects and OOP classes expect named field keys repeated inside every serialized record payload."
          [ "Lang 5.4" "Lang Appendix C.1 Trap 1" "Lang Appendix C.1 Trap 5" ]
          [ "E008" "E024" "E030" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER ]
        )
      ]
      [
        "SPEC_ALGEBRAIC_PRODUCT_TUPLE_CONSTRUCTOR"
        (
          #SPEC
          "Positional Algebraic Product Constructor ':Tuple(T1 ... Tn)'"
          "Composite records are modeled strictly as positional heterogeneous ':Tuple' types encoded with parentheses '(v1 ... vn)'. Field semantics are carried by distinct nominal types in ':defs'."
          [ "Lang 2.3" "Lang 5.4" "Lang Appendix C.1 Trap 1" "Lang Appendix C.1 Trap 5" ]
          [ "E008" "E024" ]
          [ #LENS_VOP_PURIST #LENS_DATA_ENGINEER #LENS_PRACTITIONER ]
        )
      ]
      [
        "GOAL_ZERO_COPY_POST_ORDER_WIRE_SYMPATHY"
        (
          #GOAL
          "Zero-Copy Post-Order DAG Binary Layout and Mechanical Sympathy"
          "Achieve VOP Manifesto Pillar 2 (Mechanical Sympathy Without the Wrapper Tax) by eliminating repeated field-name strings on the wire and enabling Strategy 0x0 ZERO_COPY_POST_ORDER."
          [ "Lang 10.2" "Manifesto 4.2" ]
          []
          [ #LENS_DATA_ENGINEER #LENS_VOP_PURIST ]
        )
      ]
      [
        "HAZARD_FIELD_KEY_WIRE_BLOAT_AND_KEY_TYPOS"
        (
          #HAZARD
          "Repetitive Field-Key Wire Bloat and Silent Missing-Property Typos"
          "Eliminates bandwidth inflation from repeating string keys in every record and prevents silent runtime bugs from misspelled JSON field names."
          [ "Lang 5.4" "Manifesto 4.1" ]
          [ "E008" ]
          [ #LENS_DATA_ENGINEER #LENS_VOP_PURIST ]
        )
      ]

      // --- CLUSTER 6: Mandatory Insertion Order on :Set and :Map ---
      [
        "DISSONANCE_ORDERED_SETS_AND_MAPS"
        (
          #DISSONANCE
          "Why are ':Set' and ':Map' order-dependent and why do maps use '{ [k v] }' syntax?"
          "In standard mathematics, Java, and Python, sets and maps are unordered. In STVN, reordering entries changes value equality."
          [ "Lang 5.5" "Lang 5.5.1" "Lang Appendix C.1 Trap 2" ]
          [ "E008" "E018" "E024" ]
          [ #LENS_SKEPTIC #LENS_DATA_ENGINEER #LENS_VOP_PURIST ]
        )
      ]
      [
        "SPEC_INSERTION_ORDERED_COLLECTIONS_AND_SOA_MAPS"
        (
          #SPEC
          "Insertion-Ordered ':Seq', ':Set', ':Map' and Structure-of-Arrays (SoA) Binary Maps"
          "All collections preserve insertion order and order-dependent equality. Maps encode as '{ [k1 v1] ... [kn vn] }' in text and Structure-of-Arrays (SoA) in binary, with '#invertible' enforcing dual-set bijection."
          [ "Lang 5.5.1" "Lang 5.5.4" "Lang Appendix C.1 Trap 2" ]
          [ "E008" "E018" ]
          [ #LENS_DATA_ENGINEER #LENS_PRACTITIONER #LENS_VOP_PURIST ]
        )
      ]
      [
        "GOAL_CANONICAL_VALUE_EQUIVALENCE_AND_SOA_LOCALITY"
        (
          #GOAL
          "Deterministic Cross-Runtime Value Equivalence and SoA Cache Locality"
          "Guarantee that an identical logical collection produces an identical byte stream across all languages (VOP Pillar 3) while enabling vectorized SoA binary scanning."
          [ "Lang 5.5.1" "Manifesto 4.2" ]
          []
          [ #LENS_DATA_ENGINEER #LENS_ZERO_TRUST #LENS_VOP_PURIST ]
        )
      ]
      [
        "HAZARD_CROSS_RUNTIME_HASH_ITERATION_DRIFT"
        (
          #HAZARD
          "Cross-Runtime Hash-Seed Iteration Drift Corrupting Digests"
          "Eliminates non-deterministic hash iteration order across JVM, Rust, and Go runtimes that would corrupt cryptographic digests and reproducible builds."
          [ "Lang 5.5" "Manifesto 4.2" ]
          [ "E018" ]
          [ #LENS_ZERO_TRUST #LENS_DATA_ENGINEER ]
        )
      ]

      // --- CLUSTER 7: Parentheses Strictly Forbidden as Variant Constructor Calls ---
      [
        "DISSONANCE_PARENTHESES_NEVER_FUNCTION_CALLS"
        (
          #DISSONANCE
          "Why does writing '#Some(42)' for ':Option(:Int)' fail with a fatal type mismatch?"
          "Developers from Scala, Rust, and Haskell instinctively wrap variant arguments in function-call parentheses like '#Some(42)'."
          [ "Lang 5.2.1" "Lang Appendix C.1 Trap 8" ]
          [ "E008" "MalformedPayloadException" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER ]
        )
      ]
      [
        "SPEC_STRICT_PRODUCT_DEMARCATION"
        (
          #SPEC
          "Bare Sum Variant Syntax and Strict Product Demarcation of Parentheses"
          "Sum tags ('#Some', '#Left', '#Right', '#1') precede bare values without parentheses ('#Some 42'). Parentheses '()' are exclusively ':Tuple' constructors."
          [ "Lang 5.2.1" "Lang 5.4" "Lang Appendix C.1 Trap 8" ]
          [ "E008" "MalformedPayloadException" ]
          [ #LENS_PRACTITIONER #LENS_VOP_PURIST ]
        )
      ]
      [
        "GOAL_ISOMORPHIC_DELIMITER_TO_AST_MAPPING"
        (
          #GOAL
          "Isomorphic 1:1 Correspondence Between Delimiters and AST Node Kinds"
          "Maintain a strict 1:1 mapping between delimiter tokens and AST constructs: '()' = Product Tuple, '[]' = Sequence/Set/MapEntry, '{}' = Map/Meta/Defs."
          [ "Lang 3" "Lang 5.2.1" ]
          []
          [ #LENS_VOP_PURIST #LENS_PRACTITIONER ]
        )
      ]
      [
        "HAZARD_ONE_TUPLE_VS_SCALAR_UNBOXING_AMBIGUITY"
        (
          #HAZARD
          "Ambiguity Between Parenthesized Scalar Expressions and 1-Element Tuples"
          "Prevents parser and codec ambiguity between a parenthesized scalar value and a 1-element ':Tuple' inside nested sum types."
          [ "Lang 5.2.1" "Lang Appendix C.1 Trap 8" ]
          [ "E008" "MalformedPayloadException" ]
          [ #LENS_VOP_PURIST #LENS_DATA_ENGINEER ]
        )
      ]

      // --- CLUSTER 8: Elimination of Compound Scalar & Collection Keywords ---
      [
        "DISSONANCE_NO_COMPOUND_TYPE_KEYWORDS"
        (
          #DISSONANCE
          "Why were ':Uint16', ':Int64', ':SeqNonEmpty', and ':MapInv' removed in STVN 2.0.0?"
          "Developers familiar with Rust, C, or STVN 1.x expect compact compound keywords like ':Uint16' instead of '{ #unsigned #size 16 } :Int'."
          [ "Lang 5.1" "Lang 5.5.2" "Lang Appendix A.1" ]
          [ "E009" "ERR_INTEGER_OVERFLOW" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER ]
        )
      ]
      [
        "SPEC_ORTHOGONAL_KERNEL_AND_ARBITRARY_BIT_WIDTHS"
        (
          #SPEC
          "Orthogonal 6-Scalar / 3-Collection Kernel and Arbitrary Bit-Width Integers"
          "Reduces scalars to ':Boolean', ':Int', ':Float', ':String', ':TimeEpoch', ':DateTime' and collections to ':Seq', ':Set', ':Map'. ':Int' supports any bit-width n >= 1 stored in ceil(n/8) bytes with high-bit zero masking."
          [ "Lang 5.1" "Lang 5.5.2" "Lang Appendix A.1" "Lang Appendix A.3" "Lang Appendix A.4" ]
          [ "E009" "ERR_INTEGER_OVERFLOW" "StvnCorruptedBitPatternException" ]
          [ #LENS_DATA_ENGINEER #LENS_VOP_PURIST #LENS_PRACTITIONER ]
        )
      ]
      [
        "GOAL_ORTHOGONAL_TYPE_ALGEBRA_AND_BIT_EXACT_CODECS"
        (
          #GOAL
          "Orthogonal Type Algebra and Bit-Exact Hardware Codec Containment"
          "Decouple base algebraic semantics from physical bit-width, signedness, and cardinality constraints while enforcing sub-byte hardware bit-masking."
          [ "Lang 5.1" "Lang Appendix A.3" "Lang Appendix A.4" ]
          []
          [ #LENS_DATA_ENGINEER #LENS_ZERO_TRUST ]
        )
      ]
      [
        "HAZARD_COMBINATORIAL_KEYWORD_BLOAT_AND_HIGH_BIT_SMUGGLING"
        (
          #HAZARD
          "Combinatorial Keyword Explosion and Unused High-Bit Wire Smuggling"
          "Eliminates grammar token explosion across arbitrary bit widths (e.g. 7-bit or 49-bit ints) and blocks covert data smuggling or bit-rot in unused upper bits."
          [ "Lang Appendix A.2" "Lang Appendix A.4" ]
          [ "E009" "ERR_INTEGER_OVERFLOW" "StvnCorruptedBitPatternException" ]
          [ #LENS_ZERO_TRUST #LENS_DATA_ENGINEER ]
        )
      ]

      // --- CLUSTER 9: Prohibition of #maxIncl and #minExcl on Discrete Types ---
      [
        "DISSONANCE_PROHIBITED_MAX_INCL_ON_DISCRETE_TYPES"
        (
          #DISSONANCE
          "Why is '#maxIncl' forbidden on ':Int', '{ #exact } :Float', ':TimeEpoch', and ':DateTime'?"
          "Engineers accustomed to SQL BETWEEN or JSON Schema maximum inclusive bounds expect to write '#maxIncl 65535' or '#maxIncl 2026-12-31T23:59:59Z'."
          [ "Lang 5.1.2" "Lang Appendix C.4" ]
          [ "E011" "ERR_DISCRETE_BOUND_KIND_PROHIBITED" "ERR_EMPTY_INTERVAL_DOMAIN" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER #LENS_DATA_ENGINEER ]
        )
      ]
      [
        "SPEC_DISCRETE_HALF_OPEN_INTERVAL_GOVERNANCE"
        (
          #SPEC
          "Mandatory Half-Open Interval [minIncl, maxExcl) on All Discrete Domains"
          "All discrete domains (':Int', '{ #exact } :Float', ':TimeEpoch', ':DateTime') enforce half-open intervals [minIncl, maxExcl) with Delta = maxExcl - minIncl > 0. '#maxIncl' and '#minExcl' are prohibited."
          [ "Lang 5.1.2" "Lang 6.1" "Lang Appendix C.1 Trap 12" "Lang Appendix C.4" ]
          [ "E011" "ERR_DISCRETE_BOUND_KIND_PROHIBITED" "ERR_EMPTY_INTERVAL_DOMAIN" ]
          [ #LENS_VOP_PURIST #LENS_DATA_ENGINEER #LENS_PRACTITIONER ]
        )
      ]
      [
        "GOAL_SEAMLESS_PARTITION_COMPOSITION_AND_UNIQUE_IR"
        (
          #GOAL
          "Gapless Partition Composition and Single Canonical Interval IR"
          "Ensure adjacent discrete intervals [a, b) and [b, c) compose without boundary overlap or gaps, and guarantee a unique canonical representation in the CAS preimage."
          [ "Lang 5.1.2" "Lang 9.2" "Lang Appendix C.4" ]
          []
          [ #LENS_DATA_ENGINEER #LENS_ZERO_TRUST #LENS_VOP_PURIST ]
        )
      ]
      [
        "HAZARD_OFF_BY_ONE_SHARDING_GAPS_AND_CAS_DUPLICATES"
        (
          #HAZARD
          "Fencepost Partitioning Bugs and Divergent CAS Hashes for Equal Ranges"
          "Eliminates off-by-one sharding gaps (missing sub-second ticks between 23:59:59 and 00:00:00) and prevents '#maxIncl 9' vs '#maxExcl 10' from hashing to different CAS addresses."
          [ "Lang 5.1.2" "Lang 9.2" "Lang Appendix C.4" ]
          [ "ERR_DISCRETE_BOUND_KIND_PROHIBITED" ]
          [ #LENS_DATA_ENGINEER #LENS_ZERO_TRUST ]
        )
      ]

      // --- CLUSTER 10: Prohibition of #size on :String & Mandatory Allocation Ceilings ---
      [
        "DISSONANCE_SIZE_PROHIBITED_ON_STRING"
        (
          #DISSONANCE
          "Why does '{ #size 64 } :String' fail and why do strings/exact floats cap at 16,777,216?"
          "Developers often conflate byte/bit width ('#size') with character length ('#minSize'/'#maxSize') and assume unadorned ':String' or '{ #exact } :Float' is infinitely unbounded."
          [ "Lang 3.3" "Lang 5.1.3" "Lang 5.1.5" "Lang 7.1" "Lang Appendix C.1 Trap 10" ]
          [ "E008" "E012" "ERR_STRING_CARDINALITY_PROHIBITED" "ERR_CAPACITY_OVERFLOW" ]
          [ #LENS_SKEPTIC #LENS_PRACTITIONER #LENS_ZERO_TRUST ]
        )
      ]
      [
        "SPEC_LOGICAL_CARDINALITY_VS_PHYSICAL_BIT_WIDTH"
        (
          #SPEC
          "Strict Separation of '#size' Bit-Width from '#minSize'/'#maxSize' Cardinality and 16 MiB Ceiling"
          "'#size' applies strictly to binary numeric bit-width (':Int', continuous ':Float'). Logical character/element/digit counts use '#minSize' and '#maxSize' with a concrete default allocation ceiling of 16,777,216."
          [ "Lang 3.3" "Lang 5.1.3" "Lang 5.1.5" "Lang 6.1" "Lang 7.1" "Repo 5.1" ]
          [ "E008" "E012" "ERR_STRING_CARDINALITY_PROHIBITED" "ERR_CAPACITY_OVERFLOW" ]
          [ #LENS_DATA_ENGINEER #LENS_ZERO_TRUST #LENS_PRACTITIONER ]
        )
      ]
      [
        "GOAL_BOUNDED_INGRESS_ALLOCATION_SAFETY"
        (
          #GOAL
          "Distinguish Hardware Bit-Width from Logical Cardinality with Fail-Closed Allocation Bounds"
          "Separate physical bit allocation from UTF-8 character/collection counts while enforcing a 16 MiB perimeter allocation cap across compilers and repository ingress."
          [ "Lang 3.3" "Lang 7.1" "Repo 5.1" ]
          []
          [ #LENS_ZERO_TRUST #LENS_DATA_ENGINEER ]
        )
      ]
