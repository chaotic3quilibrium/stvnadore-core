{
  :meta {
    #name "acid_test_four_clauses"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E002 #STVN_SYNTAX_ERROR #ERROR 5 3 135 140 "STVN Syntax Error: clause ':meta' requires a metadata block '{ ... }'" )
    ( #E002 #STVN_SYNTAX_ERROR #ERROR 6 3 143 148 "STVN Syntax Error: clause ':defs' requires definition block '{ ... }'" )
    ( #E002 #STVN_SYNTAX_ERROR #ERROR 7 3 151 156 "STVN Syntax Error: clause ':type' requires a schema type" )
    ( #E002 #STVN_SYNTAX_ERROR #ERROR 8 3 159 164 "STVN Syntax Error: clause ':body' requires a value payload" )
  ]
}
