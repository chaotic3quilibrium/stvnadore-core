      #ERR_TEMPORAL_SCALE_MISSING
      #ERR_LEGACY_UNIT_FACET_PURGED
      #ERR_DATETIME_MODE_INVALID
      #ERR_PRELUDE_ALIAS_PURGED
      #ERR_FACET_ORDER_VIOLATION
