{
  :meta {  // identity header
    // kind paragraph 1

    // kind paragraph 2
    #kind   #BODY_INCLUDE    // modular body-include kind

    // domain comment line 1
    // domain comment line 2

    #domain "core_fmt" // formatter suite domain

    // canonical document stem
    #name "14_comment_preserving_meta_and_facet_reordering"// stem slot 0

    // footer note line 1

    // footer note line 2
  }
  :defs {
    :BoundedTag { #regex "^[a-z_]+$" #maxSize 32 #minSize 2 } :String
    :BoundedChannel { // integer channel constraints
      // exclusive ceiling
      #maxExcl 5000 // upper bound

      // bit-width note 1

      // bit-width note 2
