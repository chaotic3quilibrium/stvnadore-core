// @spec: SPEC-11-ENUM-SUBSETS
// @case: Negative - Reject enum subset payload not in subset
// @error: MALFORMED_PAYLOAD
{
  // enum_subset_payload_not_in_subset.stvn
  :defs {
    :Priority :Enum [ #LOW #MEDIUM #HIGH #CRITICAL ]
    :StandardPriority { #filterExcl [ #CRITICAL ] } :Priority
  }

  :type :StandardPriority

  :body #CRITICAL
}
