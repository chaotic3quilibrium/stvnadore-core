// @spec: SPEC-08-COLLECTIONS
// @case: Positive - Bounded sequence cardinality between 1 and 8 elements
{
  :meta {
    #name "seq_bounded_cardinality"
    #kind #BODY
  }
  :defs {
    :BoundedSequence { #minSize 1 #maxSize 8 } :Seq( :Int )
