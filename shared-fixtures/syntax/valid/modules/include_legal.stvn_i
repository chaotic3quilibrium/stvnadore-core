// @spec: SPEC-09-MODULES-INCLUDES
// @case: Positive - Legal module include and type resolution
{
  :meta {
    #name "include_legal"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [
      "./module_a.stvn_di"
      "./module_b.stvn_di" {
        :ConflictType :ConflictTypeB
      }
    ]
  }
  :type :Tuple( :TypeA :TypeB :ConflictType :ConflictTypeB )
  :body ( 42 "hello" 100 "world" )
}
