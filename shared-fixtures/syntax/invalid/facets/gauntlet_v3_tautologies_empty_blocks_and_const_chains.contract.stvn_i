{
  :meta {
    #name "gauntlet_v3_tautologies_empty_blocks_and_const_chains"
    #domain "contract"
    #kind #BODY_INCLUDE
  }
  :defs {
    :include [ "../error_contract.stvn_d" ]
  }
  :type :ErrorContract
  :body [
    ( #E003 #ERR_EMPTY_METADATA_BLOCK #ERROR 8 20 202 204 "Empty metadata block is invalid; remove '{}' or specify valid facets" )
    ( #E008 #ERR_DUPLICATE_METADATA_FACET #ERROR 11 46 297 305 "Metadata violation (:DuplicateFacetTrap): Duplicate facet '#size' is prohibited; each facet may appear at most once per metadata block" )
    ( #E036 #ERR_UNRECOGNIZED_METADATA_FACET #ERROR 14 35 403 414 "Metadata violation (:UnknownFacetTrap): Unrecognized constraint facet '#bogusFacet'" )
    ( #E009 #ERR_EMPTY_INTERVAL_DOMAIN #ERROR 17 58 537 549 "Constraint violation (:EmptyIntervalTrap): discrete integer interval [500, 500) defines an empty domain" )
    ( #E009 #INVALID_NUMERIC_RANGE #ERROR 20 60 665 678 "Constraint violation (:InvertedBoundsTrap): effective range is invalid (#minIncl 2000 exceeds #maxExcl 1000)" )
    ( #E012 #ERR_CONSTRAINT_VIOLATION #ERROR 34 47 1118 1121 "Constraint violation (#ILLEGAL_DYNAMIC_PORT): Value 512 is outside allowable range (must be >= 1024)" )
  ]
}
