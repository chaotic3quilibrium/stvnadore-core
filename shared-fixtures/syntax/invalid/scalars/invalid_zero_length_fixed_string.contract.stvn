{
  // invalid_zero_length_fixed_string.contract.stvn
  :defs {
    :include [ "../error_contract.stvn_inclf" ]
  }

  :type :ErrorContract

  :body (
    #ERR_COMPOUND_TYPE_OBSOLETE
