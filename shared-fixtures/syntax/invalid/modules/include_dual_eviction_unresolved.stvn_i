// @spec: SPEC-09-MODULES-INCLUDES
// @case: Negative - Reject include dual eviction unresolved
// @error: MALFORMED_SCHEMA
{
  :meta {
    #name "include_dual_eviction_unresolved"
    #kind #BODY_INCLUDE
  }

  :defs {
    :include [
      "./module_dual_a.stvn_di"
      "./module_dual_b.stvn_di"
    ]
    :use [
      :org/example/dual_a { :ConflictType :AliasA }
      :org/example/dual_b { :ConflictType :AliasB }
    ]
  }
  :type :ConflictType
  :body "this should fail downstream because :ConflictType is unresolved"
}
