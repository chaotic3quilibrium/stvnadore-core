TypeRegistry:
  - :RetryCount
      schema:
        node: :Int
        aliasName: :RetryCount
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Int
  - :PortNum
      schema:
        node: :Int
        aliasName: :PortNum
        constraints:
          equatable: true (default)
          comparable: true (default)
        underlyingSchema:
          node: :Int
  - :CoordFloat
      schema:
        node: :Float
        aliasName: :CoordFloat
        constraints:
          equatable: false (default)
          comparable: true (default)
        underlyingSchema:
          node: :Float
  - <:type>
      schema:
        node: :Tuple(:RetryCount:String:PortNum:Tuple(:CoordFloat:CoordFloat):Seq(:PortNum))
        constraints:
          equatable: false (derived from :Tuple(:CoordFloat:CoordFloat))
          comparable: true (default)
ValuePayload:
  StvnTuple
    elements:
      - StvnInteger(:RetryCount): 3
      - StvnString(:String): "api.internal.net"
      - StvnInteger(:PortNum): 8000
      - StvnTuple
          elements:
            - StvnFloat(:CoordFloat): 12.34
            - StvnFloat(:CoordFloat): 56.78
      - StvnSeq
          elements:
            - StvnInteger(:PortNum): 80
            - StvnInteger(:PortNum): 443
            - StvnInteger(:PortNum): 8080
