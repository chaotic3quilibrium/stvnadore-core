// @spec: SPEC-08-COLLECTIONS
// @case: Negative - Reject invertible map value collision
// @error: COLLECTION_COLLISION
{
  :defs {
    :NominalA :Int
    :NominalB :Int
    :UnionVal :Union(:NominalA :NominalB)
    :MyMap { #invertible } :Map(:String :UnionVal)
  }
  :type :MyMap
  :body {
    ["a" #1 1]
    ["b" #2 1]
    ["c" #1 2]
    ["d" #1 2]
  }
}
